# --- Demo mode (default): runs end-to-end with seeded data, no credentials ---
DEMO_MODE=1

# --- Real PayPal sandbox: set these and flip DEMO_MODE=0 ---
# From https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# After registering your public /webhooks/paypal URL in the dashboard, put the webhook id here
PAYPAL_WEBHOOK_ID=

# --- AI drafting (optional): falls back to templates without a key ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
