# --- Demo mode (default): runs end-to-end with seeded data, no credentials ---
DEMO_MODE=1

# --- Real PayPal sandbox: set these and flip DEMO_MODE=0 ---
# From https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# After registering your public /webhooks/paypal URL in the dashboard, put the webhook id here
PAYPAL_WEBHOOK_ID=

# --- AI drafting (optional): falls back to templates without a key ---
# Also enables the AI assistant on /studio.html (Studio Agent Framework)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- AG Studio (/studio.html): trial license key from https://www.ag-grid.com ---
AG_STUDIO_LICENSE_KEY=

# --- ETA feed (optional): remote JSON URL; defaults to data/eta_feed.json ---
ETA_FEED_URL=
